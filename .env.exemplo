# Copia este ficheiro a .env e axusta os valores.
DJANGO_SECRET_KEY=cambia-esta-clave-en-producion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Porto do ordenador no que se publica a web (http://localhost:PORTO_WEB)
PORTO_WEB=8000
# Enderezo público da web, usado nas ligazóns dos correos
SITIO_URL=http://localhost:8000

# Base de datos MySQL (o servizo «db» de compose.yaml)
MYSQL_DATABASE=querocan
MYSQL_USER=querocan
MYSQL_PASSWORD=querocan
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=db
MYSQL_PORT=3306

# Correo: en desenvolvemento os correos amósanse na consola
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=QueroCan <ola@querocan.local>
CONTACTO_EMAIL=ola@querocan.gal

# Dominio público (só produción, para o HTTPS de Caddy)
DOMINIO=localhost

# Usuario e grupo do ordenador (comando «id -u» e «id -g») para os ficheiros creados desde Docker
UID_LOCAL=1000
GID_LOCAL=1000
